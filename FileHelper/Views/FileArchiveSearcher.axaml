<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileHelper.ViewModels"
             xmlns:model="using:FileHelper.Models"
             x:Class="FileHelper.Views.FileArchiveSearcher"
             x:DataType="vm:FileArchiveSearcherViewModel">


    <Grid RowDefinitions="Auto,*" Margin="0,20" RowSpacing="16">
        <StackPanel Grid.Row="0" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Добавить файлы" Command="{Binding AddFilesCommand}" Padding="16,8" />
                <Button Content="Добавить архивы" Command="{Binding AddArchivesCommand}" Padding="16,8" />
            </StackPanel>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="Файлы для поиска" FontWeight="SemiBold" />
                    <ListBox ItemsSource="{Binding FilesToFind}" Height="150" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="6">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,3">
                                    <TextBlock Text="{Binding .}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Удалить" Command="{Binding $parent[UserControl].DataContext.RemoveFileCommand}" CommandParameter="{Binding .}" Padding="8,4" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Архивы" FontWeight="SemiBold" />
                    <ListBox ItemsSource="{Binding Archives}" Height="150" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="6">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,3">
                                    <TextBlock Text="{Binding .}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Удалить" Command="{Binding $parent[UserControl].DataContext.RemoveArchiveCommand}" CommandParameter="{Binding .}" Padding="8,4" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <CheckBox Content="Сравнивать также CRC32" IsChecked="{Binding CompareCrc32}" />
                <Button Content="ПОИСК" Command="{Binding SearchCommand}" IsEnabled="{Binding CanSearch}" Padding="22,9" />
                <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding Results}" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="8">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,5">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding FilePath}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ArchiveList}" TextWrapping="Wrap" Foreground="Gray" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>


</UserControl>
